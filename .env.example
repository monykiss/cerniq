# CERNIQ — example environment (placeholders only).
#
# Copy to `.env` for local development. Never commit real values.
# Secrets marked REQUIRED have no built-in default: the backend refuses to
# start (or the feature stays disabled) when they are missing.

# ── Local infrastructure (docker-compose) ─────────────────────────────
# REQUIRED by docker-compose.yml — choose any local-only value.
DATABASE_PASSWORD=
DATABASE_URL=postgresql://cerniq:<DATABASE_PASSWORD>@localhost:5433/cerniq
REDIS_URL=redis://localhost:6380

# ── Backend core ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# REQUIRED, min 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=
# REQUIRED in production, min 32 chars. Generate: openssl rand -hex 32
API_KEY_PEPPER=
# REQUIRED in production (AES-256-GCM key, 64 hex chars). Generate: openssl rand -hex 32
DATA_ENCRYPTION_KEY=
# Admin endpoints are disabled (401) when unset.
ADMIN_KEY=

# Public URLs of this deployment
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000
# Extra CORS origins (comma-separated). No production origin is built in.
ALLOWED_ORIGINS=http://localhost:3001
ALLOW_PREVIEW_ORIGINS=false
# Only consulted when ALLOW_PREVIEW_ORIGINS=true, e.g. ^https://[a-z0-9-]+-your-team\.vercel\.app$
VERCEL_PREVIEW_ORIGIN_REGEX=

# ── Auth (Supabase, optional) ─────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
AUTH_ALLOW_LEGACY=true
KLYTICS_REQUIRE_ORG=false
KLYTICS_REQUIRE_ENTITLEMENT=false
# Opt-in only; leave unset in production.
# PLATFORM_RECOVERY_OWNER_BYPASS=
#
# Platform-admin (cross-tenant operator) access is NOT configured by email or
# env var. It is the `users.platform_admin` database flag, granted manually by
# an operator — see docs/ARCHITECTURE.md ("Authorization").

# ── OAuth (optional; leave blank to disable) ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ── Email (Resend, optional) ──────────────────────────────────────────
RESEND_API_KEY=
# Sender for auth emails, e.g. "CERNIQ <no-reply@example.com>". Unset = not sent.
EMAIL_FROM=
EMAIL_REPLY_TO=
# Domain used for notification senders (onboarding@ / alerts@).
EMAIL_FROM_DOMAIN=example.com
# Operator inbox for internal alerts. Unset = internal alerts skipped.
OPS_NOTIFY_EMAIL=

# ── Billing (Stripe test mode, optional) ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ONE_TIME=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_PARTNER=

# ── AI / LLM (optional outside production) ────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Storage (S3-compatible, optional) ─────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ENDPOINT=

# ── Market data (optional) ────────────────────────────────────────────
FRED_API_KEY=

# ── Observability (optional) ──────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Frontend (Next.js) ────────────────────────────────────────────────
NEXT_PUBLIC_NODE_API_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=false
NEXT_PUBLIC_ENABLE_GITHUB_OAUTH=false
NEXT_PUBLIC_STRIPE_SETUP_PRICE_ID=
NEXT_PUBLIC_STRIPE_PILOT_PRICE_ID=
NEXT_PUBLIC_STRIPE_STANDARD_PRICE_ID=
NEXT_PUBLIC_STRIPE_PARTNER_PRICE_ID=
